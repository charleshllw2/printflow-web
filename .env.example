# Server-only private Storefront token from Shopify's Headless sales channel.
# Never use an Admin token or a VITE_ prefix for these settings.
SHOPIFY_STORE_DOMAIN=theprintflowstudio.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SITE_URL=https://www.printflowstudio.com
SHOPIFY_TRANSFERS_COLLECTION=dtf-transfers
# Optional: exact Shopify checkout custom hostname, if configured in Shopify.
SHOPIFY_CHECKOUT_DOMAIN=

# Google Search Console: paste ONLY the content token from Google's HTML tag.
GOOGLE_SITE_VERIFICATION=
# Existing Firebase project's GA4 stream. An empty value disables this loader.
GA4_MEASUREMENT_ID=G-MW2N70WBQ4
